# Docetra production reverse proxy (single-box deploy).
#
# Usage:
#   1. Copy to /etc/nginx/sites-available/docetra.conf (or conf.d/docetra.conf).
#   2. Replace app.example.com with your domain and point DNS at this server.
#   3. Issue TLS certs:  certbot --nginx -d app.example.com
#   4. nginx -t && systemctl reload nginx
#
# Assumes:
#   - Backend Compose stack running (api published on 127.0.0.1:8000 by
#     infrastructure/docker-compose.yml).
#   - Nuxt frontend running on the host: 127.0.0.1:3000 (or built with the
#     node-server preset and kept alive by systemd/pm2).

# --- HTTP -> HTTPS -----------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    # ACME challenge for certbot; everything else redirects to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    # certbot manages these paths; adjust if you bring your own certs.
    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    # Modern TLS only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:docetra_ssl:10m;

    # Security headers.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Upload limit must match backend MAX_UPLOAD_SIZE_MB (25 MB + overhead).
    client_max_body_size 26m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # --- Backend API ---------------------------------------------------------
    # TRUSTED_HOSTS on the backend must include app.example.com.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Health/readiness endpoints can stay internal-only (loopback + VPN).
    # location /health { return 404; }
    # location /ready  { return 404; }

    # --- Nuxt frontend (node-server preset on 127.0.0.1:3000) ----------------
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Nuxt uses SSE/WebSocket payloads for hydration/dev payloads.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
