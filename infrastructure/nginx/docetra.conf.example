# Docetra production reverse proxy (single-box deploy).
#
# Usage:
#   1. Copy to /etc/nginx/sites-available/docetra.conf (or conf.d/docetra.conf).
#   2. Point DNS for docetra.minidev.in at this server.
#   3. Issue TLS certs:  certbot --nginx -d docetra.minidev.in
#   4. nginx -t && systemctl reload nginx
#
# Assumes:
#   - The Compose stack is running and its nginx edge is published on
#     127.0.0.1:${HTTP_PORT} (default 8080). That container already serves the
#     static SPA and proxies /api, /health, /ready to the API, so this host
#     proxy only needs to forward everything to it.

# --- HTTP -> HTTPS -----------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name docetra.minidev.in;

    # ACME challenge for certbot; everything else redirects to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name docetra.minidev.in;

    # certbot manages these paths; adjust if you bring your own certs.
    ssl_certificate     /etc/letsencrypt/live/docetra.minidev.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/docetra.minidev.in/privkey.pem;

    # Modern TLS only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:docetra_ssl:10m;

    # Security headers.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Upload limit must match backend MAX_UPLOAD_SIZE_MB (25 MB + overhead).
    client_max_body_size 26m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # --- Compose nginx edge (SPA + /api, /health, /ready) --------------------
    # Match HTTP_PORT in infrastructure/.env.production. TRUSTED_HOSTS on the
    # backend must include docetra.minidev.in.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Long running exports/uploads.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # SSE/WebSocket payloads.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
