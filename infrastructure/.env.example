# Docetra backend — SINGLE environment template.
# 1. Copy to .env             (local Docker development, lives in infrastructure/)
#    or to .env.production   (single-box production deploy, same folder).
# 2. Fill in every value marked with CHANGE_ME.
# 3. Never commit .env / .env.production.
#
# Run Compose with the env file as the ONE source of truth for both container
# env and ${...} interpolation (Compose does NOT read env_file for interpolation):
#   local:  docker compose -f infrastructure/docker-compose.yml up -d
#   prod:   docker compose --env-file .env.production -f docker-compose.yml up -d   (run inside infrastructure/)

BACKEND_ENV_FILE=.env
DOCETRA_COMPOSE_PROJECT=docetra-backend
APP_ENV=development            # production deploys: production
APP_HOST=0.0.0.0
APP_PORT=8000

# Published loopback ports (host tools: DBeaver, Redis UI, MinIO, RabbitMQ).
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_UI_PORT=8081             # dev/ops convenience; do not expose in production
RABBITMQ_MANAGEMENT_PORT=15672 # dev/ops convenience; do not expose in production
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001        # dev/ops convenience; do not expose in production

# PostgreSQL (Compose builds DATABASE_URL from these values).
POSTGRES_DB=docetra
POSTGRES_USER=docetra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# Frontend runs directly on the host computer. Production: https origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Redis database 0 is operational state; DB 1 and DB 2 are logical cache tiers.
CACHE_SHORT_DEFAULT_TTL_SECONDS=30
CACHE_LONG_DEFAULT_TTL_SECONDS=3600
CACHE_TTL_JITTER_PERCENT=10
CACHE_SHORT_PREFIX=docetra:short
CACHE_LONG_PREFIX=docetra:long

# RabbitMQ (Compose builds RABBITMQ_URL from these values).
RABBITMQ_USER=docetra
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
RABBITMQ_VHOST=docetra
WORKER_CONCURRENCY=2
WORKER_PREFETCH=2
WORKER_OUTBOX_POLL_SECONDS=2
JOB_MAX_RETRIES=5

# APScheduler owns meeting timers; it publishes due work to RabbitMQ.
SCHEDULER_ENGINE=apscheduler
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MISFIRE_GRACE_SECONDS=300
SCHEDULER_COALESCE=true
SCHEDULER_MAX_INSTANCES_PER_JOB=1
SCHEDULER_RECONCILE_INTERVAL_MINUTES=15
SCHEDULER_MEETING_REMINDER_INTERVAL_MINUTES=1
SCHEDULER_EXPORT_CLEANUP_INTERVAL_HOURS=1
MEETING_RECURRENCE_HORIZON_DAYS=90
MEETING_REMINDER_OFFSETS_MINUTES=1440,60,15

# Third-party email adapter for forgot-password delivery. Required in production.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
PASSWORD_RESET_TTL_MINUTES=15
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCK_MINUTES=15
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=900
MINIMUM_PASSWORD_LENGTH=8

# Telegram Bot 1: customer/user-facing meeting reminders and alerts.
TELEGRAM_MEETING_BOT_ENABLED=false
TELEGRAM_MEETING_BOT_TOKEN=
TELEGRAM_MEETING_ALLOWED_CHAT_IDS=

# Telegram Bot 2: private development and operations monitoring.
TELEGRAM_DEVOPS_BOT_ENABLED=false
TELEGRAM_DEVOPS_BOT_TOKEN=
TELEGRAM_DEVOPS_ALLOWED_CHAT_IDS=
DEVELOPMENT_EVENT_WEBHOOK_SECRET=

# Google Drive v3. Prefer per-source encrypted credentials in Settings.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Backend must issue the session cookie; JavaScript must never receive it.
SESSION_COOKIE_NAME=docetra_session
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false    # production: true (behind HTTPS reverse proxy)
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-CSRF-Token

# MinIO / S3. S3_SECRET_KEY must equal MINIO_ROOT_PASSWORD for the local stack.
MINIO_ROOT_USER=docetra
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
S3_ACCESS_KEY=docetra
S3_SECRET_KEY=CHANGE_ME_SAME_AS_MINIO_ROOT_PASSWORD
S3_BUCKET=docetra
S3_REGION=us-east-1
S3_USE_SSL=false

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Production requires >= 32 chars and must not contain the word "replace".
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=480         # production: 15
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_NAME=docetra_refresh
PASSWORD_RESET_SECRET=CHANGE_ME_64_HEX_CHARACTERS
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Upload limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg,gif,webp,txt,csv

# ---------------------------------------------------------------------------
# PRODUCTION CHECKLIST (validate_production enforces these at startup):
#   APP_ENV=production
#   SESSION_COOKIE_SECURE=true
#   CORS_ALLOWED_ORIGINS = explicit https origin(s) only, never "*"
#   TRUSTED_HOSTS = your api domain(s), never "*"
#   SMTP_HOST set (password reset needs real email delivery)
#   SESSION_SECRET / JWT_SECRET / PASSWORD_RESET_SECRET / SETTINGS_ENCRYPTION_KEY
#       = unique 32+ char values, never containing "replace"
#   POSTGRES_PASSWORD / RABBITMQ_PASSWORD / S3_SECRET_KEY = unique real values
#   JWT_ACCESS_MINUTES=15
#   MINIMUM_PASSWORD_LENGTH=10
#   Run with: docker compose --env-file .env.production -f docker-compose.yml up -d
# ---------------------------------------------------------------------------
