# FastAPI origin. Nuxt always uses this HTTP API (no mock mode).
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_API_TIMEOUT_MS=30000

# Cookie session: backend sets HttpOnly JWT cookies. Do not use bearer in production.
NUXT_PUBLIC_AUTH_MODE=cookie
NUXT_PUBLIC_CSRF_COOKIE_NAME=XSRF-TOKEN
NUXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token

NUXT_PUBLIC_USE_MOCK_DATA=false

# Optional build/deploy version shown in the application UI.
NUXT_PUBLIC_APP_VERSION=0.1.0

# Public site origin (no trailing slash) for Open Graph / Twitter image URLs.
# NUXT_PUBLIC_SITE_URL=https://app.example.com
