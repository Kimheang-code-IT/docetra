# Backend origin used when NUXT_PUBLIC_USE_MOCK_DATA=false.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Development default. Set to false when the real /api/v2 backend is available.
NUXT_PUBLIC_USE_MOCK_DATA=true

# Optional build/deploy version shown in the application UI.
NUXT_PUBLIC_APP_VERSION=0.1.0

# Public site URL used for generated social metadata.
# NUXT_PUBLIC_SITE_URL=https://app.example.com
