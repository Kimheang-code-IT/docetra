# Copy to backend.env.production, replace every REPLACE_* value, and never commit it.
BACKEND_ENV_FILE=backend.env.production
DOCETRA_COMPOSE_PROJECT=docetra-backend-production
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
ADMIN_NAME=System Administrator

CORS_ALLOWED_ORIGINS=https://app.your-domain.example
TRUSTED_HOSTS=api.your-domain.example
SESSION_COOKIE_NAME=docetra_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS_SESSION
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS_JWT
PASSWORD_RESET_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS_RESET
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_CHARACTERS_SETTINGS_ENCRYPTION
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_NAME=docetra_refresh

POSTGRES_DB=docetra
POSTGRES_USER=docetra
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
RABBITMQ_USER=docetra
RABBITMQ_PASSWORD=REPLACE_WITH_A_UNIQUE_RABBITMQ_PASSWORD
RABBITMQ_VHOST=docetra
MINIO_ROOT_USER=docetra
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_MINIO_PASSWORD
S3_ACCESS_KEY=docetra
S3_SECRET_KEY=REPLACE_WITH_THE_SAME_MINIO_PASSWORD
S3_BUCKET=docetra
S3_USE_SSL=false

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@your-domain.example
PASSWORD_RESET_URL=https://app.your-domain.example/auth/reset-password
TELEGRAM_MEETING_BOT_ENABLED=false
TELEGRAM_MEETING_BOT_TOKEN=
TELEGRAM_DEVOPS_BOT_ENABLED=false
TELEGRAM_DEVOPS_BOT_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCK_MINUTES=15
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=900
MINIMUM_PASSWORD_LENGTH=10
JOB_MAX_RETRIES=5
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,png,jpg,jpeg,gif,webp,txt,csv
SCHEDULER_TIMEZONE=UTC
MEETING_REMINDER_OFFSETS_MINUTES=1440,60,15
MEETING_RECURRENCE_HORIZON_DAYS=90
